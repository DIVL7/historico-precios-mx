node_modules/

# Los archivos crudos se descargan frescos en cada corrida del pipeline; no se
# versionan -- ver .github/workflows/scrape.yml
data/raw/

# Salidas de prueba locales
data/test_output*.json

# Logs de corridas locales
data/*.log

# Lockfiles de extract.js (evitan corridas concurrentes sobre el mismo origen)
data/.extract-*.lock

# Items crudos de detallepartidas (auditoría interna de extract.js) -- pesa
# demasiado (~12 MB) para publicarse junto al dataset, y el workflow de CI
# nunca lo commitea (ver .github/workflows/scrape.yml)
docs/data.raw.json

# Estado local de Claude Code
.claude/settings.local.json
.claude/scheduled_tasks.lock
